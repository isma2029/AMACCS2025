<?php
require_once 'conexion.php';

class TicketManager {
    private $db;

    public function __construct() {
        $this->db = Conexion::obtenerInstancia()->getConexion();
    }

    // Crear ticket (docente)
    public function crearTicket($id_usuario, $id_equipo, $titulo, $descripcion, $urgencia='media', $categoria='otro') {
        try {
            $sql = "INSERT INTO tickets (id_usuario, id_equipo, titulo, descripcion, urgencia, categoria, estado, fecha_creacion)
                    VALUES (:id_usuario, :id_equipo, :titulo, :descripcion, :urgencia, :categoria, 'pendiente', NOW())";
            $stmt = $this->db->prepare($sql);
            $stmt->bindParam(':id_usuario', $id_usuario);
            $stmt->bindParam(':id_equipo', $id_equipo);
            $stmt->bindParam(':titulo', $titulo);
            $stmt->bindParam(':descripcion', $descripcion);
            $stmt->bindParam(':urgencia', $urgencia);
            $stmt->bindParam(':categoria', $categoria);
            $stmt->execute();
            $id_ticket = $this->db->lastInsertId();

            // registrar historial inicial
            $this->agregarHistorial($id_ticket, $id_usuario, 'creado', 'Ticket creado por usuario.');

            // notificar admin (función simple)
            $this->notificarAdminNuevoTicket($id_ticket, $titulo);

            return $id_ticket;
        } catch (PDOException $e) {
            throw $e;
        }
    }

    public function agregarHistorial($id_ticket, $id_usuario, $accion, $detalle = null) {
        $sql = "INSERT INTO ticket_historial (id_ticket, id_usuario, accion, detalle, fecha)
                VALUES (:id_ticket, :id_usuario, :accion, :detalle, NOW())";
        $stmt = $this->db->prepare($sql);
        $stmt->bindParam(':id_ticket', $id_ticket);
        $stmt->bindParam(':id_usuario', $id_usuario);
        $stmt->bindParam(':accion', $accion);
        $stmt->bindParam(':detalle', $detalle);
        $stmt->execute();
    }

    public function listarTicketsPorUsuario($id_usuario) {
        $sql = "SELECT t.*, e.numero_serie, e.nombre_equipo FROM tickets t
                LEFT JOIN equipos e ON t.id_equipo = e.id_equipo
                WHERE t.id_usuario = :id_usuario ORDER BY t.fecha_creacion DESC";
        $stmt = $this->db->prepare($sql);
        $stmt->bindParam(':id_usuario', $id_usuario);
        $stmt->execute();
        return $stmt->fetchAll(PDO::FETCH_ASSOC);
    }

    private $error = '';
    
    public function getError() {
        return $this->error;
    }
    
    /**
     * Asigna un ticket a un docente
     * @param int $id_ticket ID del ticket a asignar
     * @param int $id_docente ID del docente al que se asigna
     * @param int $id_admin ID del administrador que realiza la asignación
     * @return bool True si la asignación fue exitosa
     */
    public function asignarTicket($id_ticket, $id_docente, $id_admin) {
        try {
            $this->db->beginTransaction();
            
            // Actualizar el ticket
            $sql = "UPDATE tickets SET 
                    asignado_a = :id_docente,
                    estado = 'en progreso',
                    fecha_asignacion = NOW(),
                    fecha_actualizacion = NOW()
                    WHERE id_ticket = :id_ticket";
            
            $stmt = $this->db->prepare($sql);
            $stmt->bindParam(':id_docente', $id_docente, PDO::PARAM_INT);
            $stmt->bindParam(':id_ticket', $id_ticket, PDO::PARAM_INT);
            $stmt->execute();
            
            // Registrar en el historial
            $this->agregarHistorial($id_ticket, $id_admin, 'asignado', "Ticket asignado al docente ID: $id_docente");
            
            $this->db->commit();
            return true;
            
        } catch (Exception $e) {
            $this->db->rollBack();
            error_log("Error en asignarTicket: " . $e->getMessage());
            return false;
        }
    }
    
    /**
     * Cambia el estado de un ticket
     * @param int $id_ticket ID del ticket
     * @param string $nuevo_estado Nuevo estado del ticket
     * @param int $id_usuario ID del usuario que realiza el cambio
     * @param string $comentario Comentario opcional
     * @return bool True si el cambio fue exitoso
     */
    public function cambiarEstado($id_ticket, $nuevo_estado, $id_usuario, $comentario = '') {
        try {
            $this->db->beginTransaction();
            
            // Validar estado
            $estadosPermitidos = ['pendiente', 'en progreso', 'resuelto', 'cerrado'];
            if (!in_array(strtolower($nuevo_estado), $estadosPermitidos)) {
                throw new Exception("Estado no válido");
            }
            
            // Actualizar el ticket
            $sql = "UPDATE tickets SET 
                    estado = :estado,
                    fecha_actualizacion = NOW()";
            
            // Si se marca como resuelto o cerrado, actualizar la fecha de resolución
            if (in_array(strtolower($nuevo_estado), ['resuelto', 'cerrado'])) {
                $sql .= ", fecha_resolucion = NOW()";
            }
            
            $sql .= " WHERE id_ticket = :id_ticket";
            
            $stmt = $this->db->prepare($sql);
            $stmt->bindParam(':estado', $nuevo_estado);
            $stmt->bindParam(':id_ticket', $id_ticket, PDO::PARAM_INT);
            $stmt->execute();
            
            // Registrar en el historial
            $detalle = "Cambio de estado a: " . ucfirst($nuevo_estado);
            if (!empty($comentario)) {
                $detalle .= ". Comentario: $comentario";
            }
            
            $this->agregarHistorial($id_ticket, $id_usuario, 'cambio_estado', $detalle);
            
            $this->db->commit();
            return true;
            
        } catch (Exception $e) {
            $this->db->rollBack();
            error_log("Error en cambiarEstado: " . $e->getMessage());
            return false;
        }
    }
    
    public function listarTicketsTodos() {
        try {
            // Verificar conexión
            if (!$this->db) {
                $this->error = "No hay conexión a la base de datos";
                error_log($this->error);
                return [];
            }

            // Consulta SQL mejorada con manejo de posibles valores nulos
            $sql = "SELECT 
                        t.*, 
                        COALESCE(u.usuario, 'Usuario eliminado') AS creador, 
                        COALESCE(u.nombre_completo, 'N/A') AS nombre_completo, 
                        COALESCE(e.numero_serie, 'N/A') AS numero_serie, 
                        COALESCE(e.nombre_equipo, 'N/A') AS nombre_equipo
                    FROM tickets t
                    LEFT JOIN usuarios u ON t.id_usuario = u.id_usuario
                    LEFT JOIN equipos e ON t.id_equipo = e.id_equipo
                    ORDER BY t.fecha_creacion DESC";
            
            error_log("Ejecutando consulta SQL: " . $sql);
            
            $stmt = $this->db->prepare($sql);
            if (!$stmt) {
                $error = $this->db->errorInfo();
                $this->error = "Error al preparar la consulta: " . ($error[2] ?? 'Error desconocido');
                error_log($this->error);
                return [];
            }
            
            $executed = $stmt->execute();
            if (!$executed) {
                $error = $stmt->errorInfo();
                $this->error = "Error al ejecutar la consulta: " . ($error[2] ?? 'Error desconocido');
                error_log($this->error);
                return [];
            }
            
            $result = $stmt->fetchAll(PDO::FETCH_ASSOC);
            error_log("Número de tickets encontrados: " . count($result));
            
            return $result;
            
        } catch (PDOException $e) {
            $this->error = "Error en listarTicketsTodos(): " . $e->getMessage();
            error_log($this->error);
            error_log("Trace: " . $e->getTraceAsString());
            return [];
        } catch (Exception $e) {
            $this->error = "Error general: " . $e->getMessage();
            error_log($this->error);
            return [];
        }
    }

    // La declaración duplicada de asignarTicket ha sido eliminada. Se mantiene la versión más completa.

    public function cambiarEstado($id_ticket, $estado, $id_usuario, $detalle = null) {
        $sql = "UPDATE tickets SET estado = :estado, fecha_actualizacion = NOW() WHERE id_ticket = :id_ticket";
        $stmt = $this->db->prepare($sql);
        $stmt->bindParam(':estado', $estado);
        $stmt->bindParam(':id_ticket', $id_ticket);
        $stmt->execute();

        $this->agregarHistorial($id_ticket, $id_usuario, 'cambio_estado', $detalle);
        return true;
    }

    // Notificaciones básicas (puedes adaptar a SMTP real)
    private function notificarAdminNuevoTicket($id_ticket, $titulo) {
        // Obtener correo del admin (primer admin encontrado)
        $sql = "SELECT correo FROM usuarios WHERE rol = 'admin' LIMIT 1";
        $stmt = $this->db->query($sql);
        $admin = $stmt->fetch(PDO::FETCH_ASSOC);
        if ($admin && !empty($admin['correo'])) {
            $to = $admin['correo'];
            $subject = "Nuevo ticket #$id_ticket: $titulo";
            $message = "Se ha creado un nuevo ticket. ID: $id_ticket\nTítulo: $titulo\nEntra al sistema para ver detalles.";
            // mail($to, $subject, $message); // comentar/descomentar según configuración
        }
    }

    private function notificarUsuarioAsignado($id_usuario, $id_ticket) {
        $sql = "SELECT correo FROM usuarios WHERE id_usuario = :id";
        $stmt = $this->db->prepare($sql);
        $stmt->bindParam(':id', $id_usuario);
        $stmt->execute();
        $u = $stmt->fetch(PDO::FETCH_ASSOC);
        if ($u && !empty($u['correo'])) {
            $to = $u['correo'];
            $subject = "Se te ha asignado el ticket #$id_ticket";
            $message = "Te han asignado el ticket $id_ticket. Ingresa al sistema para más información.";
            // mail($to, $subject, $message);
        }
    }

    // Método para agregar adjunto (guardar registro en ticket_attachments)
    public function agregarAdjunto($id_ticket, $filename, $filepath, $mime_type, $uploaded_by = null) {
        $sql = "INSERT INTO ticket_attachments (id_ticket, filename, filepath, mime_type, uploaded_by, uploaded_at)
                VALUES (:id_ticket, :filename, :filepath, :mime_type, :uploaded_by, NOW())";
        $stmt = $this->db->prepare($sql);
        $stmt->bindParam(':id_ticket', $id_ticket);
        $stmt->bindParam(':filename', $filename);
        $stmt->bindParam(':filepath', $filepath);
        $stmt->bindParam(':mime_type', $mime_type);
        $stmt->bindParam(':uploaded_by', $uploaded_by);
        return $stmt->execute();
    }

    /**
     * Cuenta el total de tickets en el sistema
     * @return int Número total de tickets
     */
    public function contarTickets() {
        $sql = "SELECT COUNT(*) as total FROM tickets";
        $stmt = $this->db->query($sql);
        $result = $stmt->fetch(PDO::FETCH_ASSOC);
        return (int)($result['total'] ?? 0);
    }

    /**
     * Cuenta los tickets por estado
     * @param string $estado Estado de los tickets a contar
     * @return int Número de tickets con el estado especificado
     */
    
    /**
     * Obtiene un ticket por su ID con información adicional
     * @param int $id_ticket ID del ticket a buscar
     * @return array|false Datos del ticket o false si no se encuentra
     */
    public function obtenerTicketPorId($id_ticket) {
        try {
            $sql = "SELECT 
                        t.*, 
                        u.nombre_completo as usuario_nombre,
                        u.rol as usuario_rol,
                        e.numero_serie,
                        e.nombre_equipo,
                        CONCAT(tu.nombre_completo) as tecnico_asignado_nombre,
                        e.*
                    FROM tickets t
                    LEFT JOIN usuarios u ON t.id_usuario = u.id_usuario
                    LEFT JOIN equipos e ON t.id_equipo = e.id_equipo
                    LEFT JOIN usuarios tu ON t.asignado_a = tu.id_usuario
                    WHERE t.id_ticket = :id_ticket";
            
            $stmt = $this->db->prepare($sql);
            $stmt->bindParam(':id_ticket', $id_ticket, PDO::PARAM_INT);
            $stmt->execute();
            
            $ticket = $stmt->fetch(PDO::FETCH_ASSOC);
            
            if ($ticket) {
                // Agregar información adicional
                $ticket['equipo_info'] = [
                    'id_equipo' => $ticket['id_equipo'],
                    'numero_serie' => $ticket['numero_serie'],
                    'nombre_equipo' => $ticket['nombre_equipo']
                ];
                
                if ($ticket['asignado_a']) {
                    $ticket['tecnico_asignado'] = $ticket['tecnico_asignado_nombre'];
                }
                
                return $ticket;
            }
            
            return false;
            
        } catch (PDOException $e) {
            error_log("Error en obtenerTicketPorId: " . $e->getMessage());
            return false;
        }
    }
    
    /**
     * Obtiene el historial de un ticket
     * @param int $id_ticket ID del ticket
     * @return array Historial del ticket
     */
    public function obtenerHistorialTicket($id_ticket) {
        $sql = "SELECT 
                    th.*, 
                    u.nombre_completo as usuario_nombre,
                    u.rol as usuario_rol
                FROM ticket_historial th
                LEFT JOIN usuarios u ON th.id_usuario = u.id_usuario
                WHERE th.id_ticket = :id_ticket
                ORDER BY th.fecha DESC";
        
        $stmt = $this->db->prepare($sql);
        $stmt->bindParam(':id_ticket', $id_ticket, PDO::PARAM_INT);
        $stmt->execute();
        
        return $stmt->fetchAll(PDO::FETCH_ASSOC);
    }
    
    /**
     * Obtiene las respuestas de un ticket
     * @param int $id_ticket ID del ticket
     * @return array Respuestas del ticket
     */
    public function obtenerRespuestas($id_ticket) {
        $sql = "SELECT 
                    tr.*, 
                    u.nombre_completo as nombre_usuario,
                    u.rol,
                    CASE WHEN u.rol IN ('admin', 'tecnico') THEN 1 ELSE 0 END as es_tecnico
                FROM ticket_respuestas tr
                JOIN usuarios u ON tr.id_usuario = u.id_usuario
                WHERE tr.id_ticket = :id_ticket
                ORDER BY tr.fecha ASC";
        
        $stmt = $this->db->prepare($sql);
        $stmt->bindParam(':id_ticket', $id_ticket, PDO::PARAM_INT);
        $stmt->execute();
        
        return $stmt->fetchAll(PDO::FETCH_ASSOC);
    }
    
    /**
     * Agrega una respuesta a un ticket
     * @param int $id_ticket ID del ticket
     * @param int $id_usuario ID del usuario que responde
     * @param string $respuesta Texto de la respuesta
     * @return bool True si se agregó correctamente
     */
    public function agregarRespuesta($id_ticket, $id_usuario, $respuesta) {
        try {
            $this->db->beginTransaction();
            
            // Insertar la respuesta
            $sql = "INSERT INTO ticket_respuestas (id_ticket, id_usuario, respuesta, fecha)
                    VALUES (:id_ticket, :id_usuario, :respuesta, NOW())";
            $stmt = $this->db->prepare($sql);
            $stmt->bindParam(':id_ticket', $id_ticket, PDO::PARAM_INT);
            $stmt->bindParam(':id_usuario', $id_usuario, PDO::PARAM_INT);
            $stmt->bindParam(':respuesta', $respuesta);
            $stmt->execute();
            
            // Actualizar fecha de actualización del ticket
            $sql = "UPDATE tickets SET fecha_actualizacion = NOW() WHERE id_ticket = :id_ticket";
            $stmt = $this->db->prepare($sql);
            $stmt->bindParam(':id_ticket', $id_ticket, PDO::PARAM_INT);
            $stmt->execute();
            
            // Registrar en el historial
            $this->agregarHistorial($id_ticket, $id_usuario, 'respuesta', 'Se agregó una nueva respuesta al ticket');
            
            $this->db->commit();
            return true;
            
        } catch (Exception $e) {
            $this->db->rollBack();
            error_log("Error en agregarRespuesta: " . $e->getMessage());
            return false;
        }
    }
    
    /**
     * Actualiza el estado de un ticket
     * @param int $id_ticket ID del ticket
     * @param string $nuevo_estado Nuevo estado del ticket
     * @param int $id_usuario ID del usuario que realiza el cambio
     * @param string $comentario Comentario opcional
     * @return bool True si se actualizó correctamente
     */
    public function actualizarEstado($id_ticket, $nuevo_estado, $id_usuario, $comentario = null) {
        try {
            $this->db->beginTransaction();
            
            // Actualizar estado del ticket
            $sql = "UPDATE tickets 
                    SET estado = :estado, 
                        fecha_actualizacion = NOW() 
                    WHERE id_ticket = :id_ticket";
            $stmt = $this->db->prepare($sql);
            $stmt->bindParam(':estado', $nuevo_estado);
            $stmt->bindParam(':id_ticket', $id_ticket, PDO::PARAM_INT);
            $stmt->execute();
            
            // Registrar en el historial
            $detalle = "Cambio de estado a: " . ucfirst(str_replace('_', ' ', $nuevo_estado));
            if ($comentario) {
                $detalle .= ". Comentario: $comentario";
            }
            
            $this->agregarHistorial($id_ticket, $id_usuario, 'cambio_estado', $detalle);
            
            $this->db->commit();
            return true;
            
        } catch (Exception $e) {
            $this->db->rollBack();
            error_log("Error en actualizarEstado: " . $e->getMessage());
            return false;
        }
    }
    
    /**
     * Actualiza la información de un ticket
     * @param int $id_ticket ID del ticket a actualizar
     * @param string $titulo Nuevo título
     * @param string $descripcion Nueva descripción
     * @param string $urgencia Nivel de urgencia
     * @param string $categoria Categoría del ticket
     * @param string $estado Estado del ticket
     * @param int|null $id_equipo ID del equipo (opcional)
     * @param int $id_usuario ID del usuario que realiza la actualización
     * @return bool True si se actualizó correctamente
     */
    public function actualizarTicket($id_ticket, $titulo, $descripcion, $urgencia, $categoria, $estado, $id_equipo, $id_usuario) {
        try {
            $this->db->beginTransaction();
            
            // Obtener el ticket actual para comparar cambios
            $ticket_actual = $this->obtenerTicketPorId($id_ticket);
            
            if (!$ticket_actual) {
                throw new Exception("El ticket no existe");
            }
            
            // Actualizar el ticket
            $sql = "UPDATE tickets 
                    SET titulo = :titulo,
                        descripcion = :descripcion,
                        urgencia = :urgencia,
                        categoria = :categoria,
                        estado = :estado,
                        id_equipo = :id_equipo,
                        fecha_actualizacion = NOW()
                    WHERE id_ticket = :id_ticket";
                    
            $stmt = $this->db->prepare($sql);
            $stmt->bindParam(':titulo', $titulo);
            $stmt->bindParam(':descripcion', $descripcion);
            $stmt->bindParam(':urgencia', $urgencia);
            $stmt->bindParam(':categoria', $categoria);
            $stmt->bindParam(':estado', $estado);
            $stmt->bindValue(':id_equipo', $id_equipo, $id_equipo ? PDO::PARAM_INT : PDO::PARAM_NULL);
            $stmt->bindParam(':id_ticket', $id_ticket, PDO::PARAM_INT);
            $stmt->execute();
            
            // Registrar cambios en el historial
            $cambios = [];
            
            if ($ticket_actual['titulo'] !== $titulo) {
                $cambios[] = "Título: \"{$ticket_actual['titulo']}\" → \"$titulo\"";
            }
            
            if ($ticket_actual['descripcion'] !== $descripcion) {
                $cambios[] = "Se modificó la descripción";
            }
            
            if ($ticket_actual['urgencia'] !== $urgencia) {
                $cambios[] = "Urgencia: " . ucfirst($ticket_actual['urgencia']) . " → " . ucfirst($urgencia);
            }
            
            if ($ticket_actual['categoria'] !== $categoria) {
                $cambios[] = "Categoría: " . ucfirst($ticket_actual['categoria']) . " → " . ucfirst($categoria);
            }
            
            if ($ticket_actual['estado'] !== $estado) {
                $cambios[] = "Estado: " . ucfirst(str_replace('_', ' ', $ticket_actual['estado'])) . 
                             " → " . ucfirst(str_replace('_', ' ', $estado));
            }
            
            if (($ticket_actual['id_equipo'] != $id_equipo) || 
                (is_null($ticket_actual['id_equipo']) && !is_null($id_equipo)) || 
                (!is_null($ticket_actual['id_equipo']) && is_null($id_equipo))) {
                
                $equipo_anterior = $ticket_actual['id_equipo'] ? "#{$ticket_actual['id_equipo']}" : "Ninguno";
                $nuevo_equipo = $id_equipo ? "#$id_equipo" : "Ninguno";
                $cambios[] = "Equipo: $equipo_anterior → $nuevo_equipo";
            }
            
            // Si hay cambios, registrar en el historial
            if (!empty($cambios)) {
                $detalle = "Se actualizó el ticket: " . implode(", ", $cambios);
                $this->agregarHistorial($id_ticket, $id_usuario, 'actualizacion', $detalle);
            }
            
            $this->db->commit();
            return true;
            
        } catch (Exception $e) {
            $this->db->rollBack();
            error_log("Error en actualizarTicket: " . $e->getMessage());
            throw $e;
        }
    }
    public function contarTicketsPorEstado($estado) {
        $sql = "SELECT COUNT(*) as total FROM tickets WHERE estado = :estado";
        $stmt = $this->db->prepare($sql);
        $stmt->bindParam(':estado', $estado);
        $stmt->execute();
        $result = $stmt->fetch(PDO::FETCH_ASSOC);
        return (int)($result['total'] ?? 0);
    }
}
