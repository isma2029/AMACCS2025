-- Crear BD con utf8mb4
CREATE DATABASE soporte_local CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE soporte_local;

-- Tabla usuarios
CREATE TABLE IF NOT EXISTS usuarios (
    id_usuario INT AUTO_INCREMENT PRIMARY KEY,
    nombre_completo VARCHAR(150) NOT NULL,
    correo VARCHAR(150) UNIQUE NOT NULL,
    usuario VARCHAR(50) UNIQUE NOT NULL,
    contrasena VARCHAR(255) NOT NULL,
    rol ENUM('admin','docente') NOT NULL DEFAULT 'docente',
    primer_inicio BOOLEAN NOT NULL DEFAULT TRUE,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT NULL,
    INDEX (usuario),
    INDEX (correo)
) ENGINE=INNODB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Tabla equipos (inventario)
CREATE TABLE IF NOT EXISTS equipos (
    id_equipo INT AUTO_INCREMENT PRIMARY KEY,
    nombre_equipo VARCHAR(100) NOT NULL,
    numero_serie VARCHAR(150) UNIQUE NOT NULL,
    ubicacion VARCHAR(150),
    estado ENUM('activo','en reparacion','fuera de servicio') DEFAULT 'activo',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    updated_at DATETIME DEFAULT NULL,
    INDEX (numero_serie),
    INDEX (ubicacion)
) ENGINE=INNODB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Tabla tickets
CREATE TABLE IF NOT EXISTS tickets (
    id_ticket INT AUTO_INCREMENT PRIMARY KEY,
    id_usuario INT NOT NULL,
    id_equipo INT NULL,
    titulo VARCHAR(200) NOT NULL,
    descripcion TEXT NOT NULL,
    urgencia ENUM('baja','media','alta') DEFAULT 'media',
    categoria ENUM('hardware','software','otro') DEFAULT 'otro',
    estado ENUM('pendiente','en proceso','resuelto','rechazado','cancelado') DEFAULT 'pendiente',
    asignado_a INT NULL, -- id del admin/técnico asignado
    fecha_creacion DATETIME DEFAULT CURRENT_TIMESTAMP,
    fecha_actualizacion DATETIME DEFAULT NULL,
    fecha_cierre DATETIME NULL,
    FOREIGN KEY (id_usuario) REFERENCES usuarios(id_usuario) ON UPDATE CASCADE ON DELETE RESTRICT,
    FOREIGN KEY (id_equipo) REFERENCES equipos(id_equipo) ON UPDATE CASCADE ON DELETE SET NULL,
    FOREIGN KEY (asignado_a) REFERENCES usuarios(id_usuario) ON UPDATE CASCADE ON DELETE SET NULL,
    INDEX (estado),
    INDEX (urgencia),
    INDEX (fecha_creacion),
    INDEX (id_equipo)
) ENGINE=INNODB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Historial de cambios de tickets (mejor que un historial genérico)
CREATE TABLE IF NOT EXISTS ticket_historial (
    id_historial INT AUTO_INCREMENT PRIMARY KEY,
    id_ticket INT NOT NULL,
    id_usuario INT NULL, -- quien realizó la acción (puede ser admin o docente)
    accion VARCHAR(100) NOT NULL, -- p.ej. 'cambio_estado','comentario','asignado'
    detalle TEXT NULL,
    fecha DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_ticket) REFERENCES tickets(id_ticket) ON DELETE CASCADE,
    FOREIGN KEY (id_usuario) REFERENCES usuarios(id_usuario) ON DELETE SET NULL,
    INDEX (id_ticket),
    INDEX (id_usuario)
) ENGINE=INNODB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Adjuntos de tickets (capturas, logs)
CREATE TABLE IF NOT EXISTS ticket_attachments (
    id_attachment INT AUTO_INCREMENT PRIMARY KEY,
    id_ticket INT NOT NULL,
    filename VARCHAR(255) NOT NULL,
    filepath VARCHAR(255) NOT NULL,
    mime_type VARCHAR(100),
    uploaded_by INT NULL,
    uploaded_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_ticket) REFERENCES tickets(id_ticket) ON DELETE CASCADE,
    FOREIGN KEY (uploaded_by) REFERENCES usuarios(id_usuario) ON DELETE SET NULL
) ENGINE=INNODB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Software instalado (simple). Si prefieres catálogo separado, lo puedo cambiar.
CREATE TABLE IF NOT EXISTS software_instalado (
    id_software INT AUTO_INCREMENT PRIMARY KEY,
    id_equipo INT NOT NULL,
    nombre_software VARCHAR(150) NOT NULL,
    VERSION VARCHAR(50),
    estado ENUM('estable','con error','obsoleto') DEFAULT 'estable',
    fecha_registro DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_equipo) REFERENCES equipos(id_equipo) ON DELETE CASCADE,
    INDEX (nombre_software),
    INDEX (id_equipo)
) ENGINE=INNODB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Solicitudes de software por docentes
CREATE TABLE IF NOT EXISTS solicitudes_software (
    id_solicitud INT AUTO_INCREMENT PRIMARY KEY,
    id_docente INT NOT NULL,
    nombre_software VARCHAR(150) NOT NULL,
    version_solicitada VARCHAR(50),
    estado ENUM('pendiente','aceptado','rechazado') DEFAULT 'pendiente',
    comentario_admin VARCHAR(255),
    fecha_solicitud DATETIME DEFAULT CURRENT_TIMESTAMP,
    fecha_respuesta DATETIME NULL,
    FOREIGN KEY (id_docente) REFERENCES usuarios(id_usuario) ON DELETE CASCADE,
    INDEX (id_docente),
    INDEX (estado)
) ENGINE=INNODB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Historial general / auditoría (eventos fuera de tickets)
CREATE TABLE IF NOT EXISTS historial (
    id_historial_general INT AUTO_INCREMENT PRIMARY KEY,
    id_usuario INT NULL,
    accion VARCHAR(150) NOT NULL,
    detalle TEXT,
    fecha DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_usuario) REFERENCES usuarios(id_usuario) ON DELETE SET NULL,
    INDEX (id_usuario)
) ENGINE=INNODB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

